# ------------------------------------------------------------------
# umemaai_undated_version — frontend (Next.js) configuration
# Copy to frontend/.env.production (or set in your process manager).
# ------------------------------------------------------------------

# Internal URL the Next.js server uses to reach the API (server-side rendering, rewrites)
BACKEND_URL=http://192.168.100.198:4000

# Canonical public URL (sitemap, canonical tags, Open Graph)
NEXT_PUBLIC_SITE_URL=http://192.168.100.198:3000

# Leave empty when nginx proxies /realtime on the same domain (recommended).
# Set only if the API is on a different origin, e.g. https://api.example.com
NEXT_PUBLIC_SOCKET_URL=

# Local print bridge for LAN printers (runs on the POS computer)
NEXT_PUBLIC_PRINT_BRIDGE_URL=http://192.168.100.198:9123

NEXT_TELEMETRY_DISABLED=1
