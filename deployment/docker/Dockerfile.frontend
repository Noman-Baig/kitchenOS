# Build context: project root  (docker build -f deployment/docker/Dockerfile.frontend .)
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
ARG NEXT_PUBLIC_SITE_URL=https://app.example.com
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL NEXT_TELEMETRY_DISABLED=1
# BACKEND_URL is a runtime value for SSR fetches; pages fall back to defaults if the API is unreachable at build time.
RUN rm -rf .next && npm run build

FROM node:22-bookworm-slim
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
WORKDIR /app
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public
RUN useradd -r -u 10001 umema
USER umema
EXPOSE 3000
CMD ["node", "server.js"]
